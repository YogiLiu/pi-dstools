{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "ignorePatterns": [
    ".agents/**",
    ".pi/**",
    ".plans/**",
    "**/node_modules/**",
    "coverage/**",
    "**/coverage/**",
    "pnpm-lock.yaml",
    "skills-lock.json"
  ]
}
