{
  "name": "@pi-dstools/search",
  "version": "0.1.1",
  "description": "DeepSeek Search API tool for Pi coding agent",
  "keywords": [
    "deepseek",
    "pi-coding-agent",
    "pi-package",
    "search"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YogiLiu/pi-dstools.git"
  },
  "files": [
    "src",
    "extensions",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix --fix-suggestions .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm --dir ../.. test",
    "test:watch": "pnpm --dir ../.. test:watch",
    "pack:dry-run": "pnpm pack --dry-run"
  },
  "dependencies": {
    "@pi-dstools/deepseek": "workspace:*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "^22.19.19",
    "typebox": "1.3.27",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "changelogPath": "./CHANGELOG.md"
  }
}
